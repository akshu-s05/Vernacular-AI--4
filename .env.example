OPENAI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=

# Translation Engine
DEFAULT_SOURCE_LANGUAGE=Hindi
DEFAULT_TARGET_LANGUAGE=Santali

# Audio & TTS Configuration
TTS_ENGINE=local_browser_speech
AUDIO_STORAGE_PATH=./data/audio

# J-Guruji Authoritative Syllabus Source
JGURUJI_BASE_URL=https://jguruji.jharkhand.gov.in
CURRICULUM_DATA_FILE=./data/curriculum/jguruji_class1_5_raw.json
