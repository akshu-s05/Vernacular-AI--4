# Vernacular AI - Environment Configuration

# Database
DATABASE_URL=sqlite:///./vernacular_ai.db

# JWT Security
SECRET_KEY=vernacular_ai_secret_key_jharkhand_sih26042_secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Server
HOST=127.0.0.1
PORT=8000
DEBUG=True

# AI Services Configuration
# Set OPENAI_API_KEY or BHASHINI_API_KEY when available; otherwise system runs in fully offline/local rule-grounded mode
